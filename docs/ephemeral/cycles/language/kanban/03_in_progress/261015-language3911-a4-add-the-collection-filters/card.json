  "criteria": [
    {
      "text": "fc-collection: a table per filter over arrays, string inputs coerced exactly as FOR coerces them, objects and empty or missing input: join (join=\", \"), length (items of a list, characters of a text, keys of an object), first, last, slice (slice:start=1,end=3), lines (split text on line breaks, CRLF included) and unique",
      "verify": "test",
      "evidence": null,
      "status": "pending"
    },
    {
      "text": "fc-order: sort is stable and deterministic: numbers numeric, strings by code unit, sort=key orders objects by that key, a mixed list sorts numbers before strings; unique keeps the first occurrence of each value",
      "verify": "test",
      "evidence": null,
      "status": "pending"
    },
    {
      "text": "fc-json: json prints a compact JSON text of the value with stable key order; a cyclic value is a type-error located at the variable; a wrong or undeclared parameter on any collection filter is a type-error located at the variable",
      "verify": "test",
      "evidence": null,
      "status": "pending"
    }
  ],
