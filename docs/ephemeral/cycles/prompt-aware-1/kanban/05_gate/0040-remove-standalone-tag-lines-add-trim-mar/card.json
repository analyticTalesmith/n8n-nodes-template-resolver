{
  "id": "0040-remove-standalone-tag-lines-add-trim-mar",
  "title": "Remove standalone tag lines, add trim markers, RAW and brace escaping",
  "type": "task",
  "parent": null,
  "depends_on": [],
  "origin": "prompt-aware-1",
  "tier": null,
  "claimed_in": null,
  "files_scope": [
    "core/src/",
