  "criteria": [
    {
      "text": "rr-result: render returns ok, output, messages, stats (chars, estTokens, sectionsOmitted, iterations) and diagnostics; on a template or data error it does not throw, returns ok false, an empty output and the located error first in diagnostics",
      "verify": "test",
      "traces": [
        "tests/headless/render.test.ts#rr-result"
      ]
    },
    {
      "text": "rr-validate: validate returns ok and diagnostics for syntax errors and unknown filters without needing data",
      "verify": "test",
      "traces": [
        "tests/headless/render.test.ts#rr-validate"
      ]
    },
    {
      "text": "rr-analyze: analyze variables carry required (the opposite of optional) and the result carries blocks, a count per block kind",
      "verify": "test",
      "traces": [
        "tests/headless/render.test.ts#rr-analyze"
      ]
    },
    {
      "text": "rr-spec: spec lists blocks, filters, operators, limits and a version, and every filter the engine accepts appears in it",
      "verify": "test",
      "traces": [
        "tests/headless/spec.test.ts#rr-spec"
      ]
    },
    {
      "text": "rr-estimator: estTokens is ceil(chars/4) by default and a tokenEstimator option replaces it",
      "verify": "test",
      "traces": [
        "tests/headless/render.test.ts#rr-estimator"
      ]
    },
    {
      "text": "rr-compat: resolveTemplate still returns a string and throws, and limits in render options bound the render with their diagnostics",
      "verify": "test",
      "traces": [
        "tests/headless/render.test.ts#rr-compat"
      ]
    },
    {
      "text": "nd-output: the n8n node writes the render output to the configured field, and a failed render throws a node error whose message carries the first diagnostic with line and column",
      "verify": "test",
      "traces": [
        "tests/headless/node.test.ts#nd-output"
      ]
    },
    {
      "text": "nd-nodeps: package.json declares no runtime dependencies, tsconfig builds api and cli folders, and package.json exposes the template-resolver bin",
      "verify": "test",
      "traces": [
        "tests/headless/nodeps.test.ts#nd-nodeps"
      ]
    },
    {
      "text": "rr-robust: render and validate never throw for non-object data (null, array, string), cyclic data values or a cyclic value looped over in strict mode; each returns ok false with a diagnostic",
      "verify": "test",
      "evidence": null,
      "status": "pending",
      "traces": [
        "tests/headless/render-robust.test.ts#rr-robust"
      ]
    }
  ],
